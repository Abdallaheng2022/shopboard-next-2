# Copy this file to .env.local and change the value. .env* files are not committed.
# The API server, read on the server only. Without it, the app uses https://shopboard-api.vercel.app/api.
# To test the loading, error and empty states, put /delay/3000, /fail/500 or /empty BEFORE /api:
# API_BASE_URL=https://shopboard-api.vercel.app/delay/3000/api
# API_BASE_URL=https://shopboard-api.vercel.app/fail/500/api
# API_BASE_URL=https://shopboard-api.vercel.app/empty/api
API_BASE_URL=https://shopboard-api.vercel.app/api
